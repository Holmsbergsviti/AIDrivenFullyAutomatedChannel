# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel
TELEGRAM_BOT_USERNAME=

# Text generation (optional; without keys the bot uses its fallback posts)
USE_GROQ=false
GROQ_API_KEY=
OPENAI_API_KEY=

# Images (optional; without either, a text card is drawn locally)
USE_DALLE=false
USE_UNSPLASH=false
UNSPLASH_ACCESS_KEY=

# Channel and schedule
CHANNEL_TOPIC=Signals of the Future
MORNING_POST_TIME=10:00
EVENING_POST_TIME=20:00
TIMEZONE=UTC
